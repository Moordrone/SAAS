{
  "name": "EasyEM with openEMS",
  "build": {
    "dockerfile": "../Dockerfile.worker",
    "context": ".."
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "postCreateCommand": "python3 -c \"import openEMS, CSXCAD; print('openEMS ready in codespace')\"",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter"
      ]
    }
  },
  "forwardPorts": [
    8000,
    3000
  ],
  "remoteUser": "app"
}