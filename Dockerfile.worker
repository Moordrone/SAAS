# ---------------------------------------------------------------------------
# Worker image: the application, plus openEMS compiled from source.
#
# The API image does not need openEMS and stays small; only the worker actually
# runs the solver, so only the worker pays for it. openEMS is not on PyPI and
# has no Debian package that tracks upstream, so it is built here once and cached
# as a Docker layer.
#
# Build:  docker build -f Dockerfile.worker -t easyem-worker .
# It is a long first build (~10-15 min): openEMS pulls in CSXCAD, fparser,
# QCSXCAD and the Python bindings. The layer is cached afterwards.
# ---------------------------------------------------------------------------
FROM python:3.12-slim-bookworm AS openems-build

ENV DEBIAN_FRONTEND=noninteractive
# Build dependencies for openEMS and its subprojects. hdf5/tinyxml/boost are the
# numerics; vtk is needed by the Python bindings' post-processing.
RUN apt-get update && apt-get install -y --no-install-recommends \
        git cmake g++ make \
        libhdf5-dev libvtk9-dev libboost-all-dev \
        libcgal-dev libtinyxml-dev libfparser-dev \
        qtbase5-dev libqt5xml5 \
        python3-dev python3-numpy python3-h5py \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
# openEMS ships a build script that clones and builds every subproject in the
# right order. Pinning a tag keeps the image reproducible; bump it deliberately.
ARG OPENEMS_REF=v0.0.36
RUN git clone --recursive --branch ${OPENEMS_REF} \
        https://github.com/thliebig/openEMS-Project.git \
    && cd openEMS-Project \
    && ./update_openEMS.sh /opt/openems --python

# ---------------------------------------------------------------------------
FROM python:3.12-slim-bookworm

ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
# Runtime libraries only — the -dev headers stay in the build stage.
# Runtime libraries. Package version numbers change between Debian releases
# (bookworm -> trixie renamed several of these), so match by unversioned name
# and let apt resolve whatever the base image ships. The -dev packages already
# pull the runtime .so as a dependency, which sidesteps the naming entirely.
RUN apt-get update && apt-get install -y --no-install-recommends \
        libhdf5-dev libvtk9-dev libboost-thread-dev libtinyxml-dev \
        libfparser-dev libqt5xml5 libpq5 \
    && rm -rf /var/lib/apt/lists/*

# openEMS itself, copied out of the build stage.
COPY --from=openems-build /opt/openems /opt/openems
ENV PATH="/opt/openems/bin:${PATH}" \
    LD_LIBRARY_PATH="/opt/openems/lib:${LD_LIBRARY_PATH}" \
    PYTHONPATH="/opt/openems/lib/python3.12/site-packages:${PYTHONPATH}"

WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential libpq-dev && rm -rf /var/lib/apt/lists/*
COPY pyproject.toml ./
RUN pip install --no-cache-dir -e ".[dev]"
COPY . .

# Confirm openEMS is importable at build time. A worker image that cannot import
# the solver should fail to build, not fail silently at the first job.
RUN python3 -c "import openEMS, CSXCAD; print('openEMS OK')"

RUN mkdir -p /var/lib/easyem/runs && useradd -m app \
    && chown -R app:app /app /var/lib/easyem/runs
USER app

CMD ["python", "-m", "easyem.jobs.worker"]
