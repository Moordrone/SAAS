# ---------------------------------------------------------------------------
# EasyEM openEMS worker
#
# openEMS is compiled once in a dedicated build stage. The final image contains
# only the solver runtime, its Python bindings, and the EasyEM worker.
# ---------------------------------------------------------------------------

FROM python:3.11-slim-bookworm AS solver-build

ARG OPENEMS_REF=v0.0.36
ARG OPENEMS_COMMIT=d0d2e8dad8a02388f1919bbcdd29a67e9199dd2c
ARG OPENEMS_BUILD_JOBS=2

ENV DEBIAN_FRONTEND=noninteractive

# Native dependencies required to compile openEMS, CSXCAD, and fparser.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        git \
        libboost-all-dev \
        libcgal-dev \
        libhdf5-dev \
        libtinyxml-dev \
        libvtk9-dev \
    && rm -rf /var/lib/apt/lists/*

# Versions compatible with the openEMS v0.0.36 Python bindings.
RUN python -m pip install --no-cache-dir \
        setuptools==68.2.2 \
        wheel==0.43.0 \
        Cython==0.29.37 \
        numpy==1.26.4

WORKDIR /src

# Clone the pinned openEMS release and only the headless subprojects.
# Clone the pinned openEMS release and only the headless subprojects.
RUN git clone --depth 1 --branch "${OPENEMS_REF}" \
        https://github.com/thliebig/openEMS-Project.git openEMS-Project \
    && cd openEMS-Project \
    && test "$(git rev-parse HEAD)" = "${OPENEMS_COMMIT}" \
    && git submodule update --init --depth 1 \
        fparser \
        CSXCAD \
        openEMS \
    # Make CMake use the static release versions. Shallow submodules do not
    # contain enough Git history for `git describe --tags`.
    && rm -f CSXCAD/.git openEMS/.git
# Build the headless solver. QCSXCAD and AppCSXCAD are not required.
RUN cmake \
        -S /src/openEMS-Project \
        -B /src/build \
        -DCMAKE_INSTALL_PREFIX=/opt/openEMS \
        -DBUILD_APPCSXCAD=OFF \
        -DWITH_MPI=OFF \
    && cmake --build /src/build --parallel "${OPENEMS_BUILD_JOBS}"

# Build portable wheels for the two Python bindings.
WORKDIR /src/openEMS-Project/CSXCAD/python

RUN python setup.py \
        build_ext \
        -I/opt/openEMS/include \
        -L/opt/openEMS/lib \
        -R/opt/openEMS/lib \
        bdist_wheel \
        --dist-dir /wheels

WORKDIR /src/openEMS-Project/openEMS/python

RUN python setup.py \
        build_ext \
        -I/opt/openEMS/include \
        -L/opt/openEMS/lib \
        -R/opt/openEMS/lib \
        bdist_wheel \
        --dist-dir /wheels \
    && git -C /src/openEMS-Project rev-parse HEAD \
        > /opt/openEMS/source-revision.txt

# ---------------------------------------------------------------------------
# Runtime image
# ---------------------------------------------------------------------------

FROM python:3.11-slim-bookworm AS runtime

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/opt/openEMS/bin:${PATH}" \
    LD_LIBRARY_PATH="/opt/openEMS/lib" \
    MPLBACKEND=Agg \
    MPLCONFIGDIR=/tmp/matplotlib \
    EASYEM_OPENEMS_THREADS=2 \
    EASYEM_OPENEMS_VERSION=0.0.36 \
    EASYEM_RUN_ROOT=/var/lib/easyem/runs

# Runtime libraries required by openEMS and its Python bindings.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libboost-chrono1.74.0 \
        libboost-date-time1.74.0 \
        libboost-serialization1.74.0 \
        libboost-system1.74.0 \
        libboost-thread1.74.0 \
        libgmp10 \
        libhdf5-103-1 \
        libhdf5-hl-100 \
        libmpfr6 \
        libpq5 \
        libtinyxml2.6.2v5 \
        libvtk9.1 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=solver-build /opt/openEMS /opt/openEMS
COPY --from=solver-build /wheels /tmp/openems-wheels

# Install the openEMS bindings and their Python runtime dependencies.
RUN python -m pip install --no-cache-dir \
        numpy==1.26.4 \
        "h5py>=3.10,<4" \
        "matplotlib>=3.8,<4" \
        /tmp/openems-wheels/*.whl \
    && rm -rf /tmp/openems-wheels

WORKDIR /app

COPY . .

RUN python -m pip install --no-cache-dir . \
    && useradd --uid 1000 --create-home app \
    && mkdir -p /var/lib/easyem/runs/openems \
    && chown -R app:app /app /var/lib/easyem/runs

# Fail the image build immediately if the solver bindings are unusable.
RUN command -v openEMS \
    && python -c "import openEMS, CSXCAD; from openEMS import openEMS as Solver; from CSXCAD import ContinuousStructure; solver = Solver(); solver.SetCSX(ContinuousStructure()); print('OPENEMS_IMPORT_OK')"

USER app

CMD ["python", "-m", "easyem.jobs.worker"]